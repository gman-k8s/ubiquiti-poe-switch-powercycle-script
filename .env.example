# Kopieren nach .env und Werte anpassen. .env NICHT committen (siehe .gitignore).

# UniFi Network Application Controller
CONTROLLER_URL=https://192.168.100.200:8443
CONTROLLER_VERIFY_SSL=false
# Site-Short-Name aus der URL (Settings -> Site -> URL-Slug), case-sensitive!
# NICHT der Display-Name. Zu sehen in der Controller-URL: .../manage/site/<hier>/...
UNIFI_SITE=default

# Dedizierter lokaler Service-Account (kein Cloud/SSO/MFA)
UNIFI_USERNAME=
UNIFI_PASSWORD=

# Switch-Identifikation: Substring, das im "name" oder "model" des Switches
# in /api/s/<site>/stat/device vorkommt (z.B. "USW-Pro-24" oder "PoE-Switch-EG")
SWITCH_IDENTIFIER=

# Ziel-Geraet
TARGET_IP=192.168.100.20
TARGET_PORT_IDX=5

# Ping-Check
PING_COUNT=3
PING_TIMEOUT=2

# Sperrt erneuten Power-Cycle fuer N Sekunden nach einem Cycle
COOLDOWN_SECONDS=300

# Logging / State
LOG_FILE=./poe_powercycle.log
STATE_DIR=./state
